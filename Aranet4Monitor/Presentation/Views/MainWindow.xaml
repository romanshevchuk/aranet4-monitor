<Window x:Class="Aranet4Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aranet4Monitor"
        xmlns:controls="clr-namespace:Aranet4Monitor.Presentation.Controls"
        Title="Aranet4 Monitor" Height="740" Width="1180" MinHeight="640" MinWidth="940"
        Background="#F3F6FB" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Aranet4Monitor;component/Presentation/Resources/DashboardResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <!-- Header: brand, device chip, status, menu -->
        <Border Padding="22,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0F1B2E" Offset="0" />
                    <GradientStop Color="#1B3354" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="30" Height="30" Margin="0,0,12,0">
                        <Ellipse Stroke="#4386F5" StrokeThickness="2.5" />
                        <Ellipse Width="10" Height="10" Fill="#89B4FF" />
                    </Grid>
                                    <TextBlock Text="Aranet4 Monitor" Foreground="White" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="DeviceChipButton" Grid.Column="1" Style="{StaticResource DeviceChip}" Margin="20,0,0,0" VerticalAlignment="Center"
                        Click="DeviceChip_Click" ToolTip="Sensor details and device list">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="DeviceDot" Width="9" Height="9" Fill="#8FA3BF" Margin="0,0,9,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="ChipNameText" Text="Searching for sensor…" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock x:Name="LastSeenText" Text="" Foreground="#9DB8E0" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="▾" Foreground="#9DB8E0" Margin="9,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,10,0"
                        Background="#22385A" BorderBrush="#36507A" BorderThickness="1" CornerRadius="14" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDotStyle}" />
                        <TextBlock x:Name="StatusText" Foreground="#DDEBFF" Text="Ready to listen" FontWeight="SemiBold"
                                   MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Button x:Name="MoreButton" Grid.Column="3" Style="{StaticResource GhostButton}" Margin="0" Padding="12,2" FontSize="20"
                        Content="⋯" VerticalAlignment="Center" Click="MoreButton_Click" ToolTip="More">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreMenu" Placement="Bottom">
                            <MenuItem x:Name="StartMenuItem" Header="Start listening" Click="StartButton_Click" />
                            <MenuItem x:Name="StopMenuItem" Header="Stop listening" Click="StopButton_Click" IsEnabled="False" />
                            <Separator />
                            <MenuItem Header="Temperature unit">
                                <MenuItem x:Name="CelsiusUnitMenuItem" Header="Celsius (°C)" Tag="Celsius" IsCheckable="True" Click="TemperatureUnit_Click" />
                                <MenuItem x:Name="FahrenheitUnitMenuItem" Header="Fahrenheit (°F)" Tag="Fahrenheit" IsCheckable="True" Click="TemperatureUnit_Click" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Forget detected devices" Click="ClearButton_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Device list + Bluetooth diagnostics: out of the way until wanted -->
                <Popup x:Name="DevicePopup" PlacementTarget="{Binding ElementName=DeviceChipButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="DevicePopup_Closed">
                    <Border Width="400" Margin="12,4,18,18" Style="{StaticResource CardStyle}" Padding="16">
                        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" /></Border.Effect>
                        <StackPanel>
                            <Grid Margin="2,0,2,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="YOUR DEVICES" Foreground="{StaticResource Ink}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#EAF2FF" CornerRadius="10" Padding="9,2">
                                    <TextBlock x:Name="DevicesCountText" Text="0" Foreground="#2F6FDD" FontWeight="Bold" FontSize="12" />
                                </Border>
                            </Grid>
                            <ListBox x:Name="DevicesList" ItemsSource="{Binding Devices}"
                                     SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                     SelectionChanged="DevicesList_SelectionChanged" MaxHeight="230"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Margin="0,5,10,0" VerticalAlignment="Top">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#B6C2D3" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter Property="Fill" Value="#2EC27E" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Address}" Foreground="{StaticResource Muted}" FontSize="11" FontFamily="Cascadia Mono, Consolas" Margin="0,3,0,0" />
                                                <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0">
                                                    <Run Text="Firmware " /><Run Text="{Binding Firmware, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Packets, Mode=OneWay}" /><Run Text=" packets" />
                                                </TextBlock>
                                                <TextBlock Text="{Binding IntegrationState}" Foreground="#3870C7" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Right">
                                                <controls:SignalBars Bars="{Binding SignalBars}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding LastSeenAgo}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="EmptyHintText" Text="No devices yet. Press “Start listening” in the ⋯ menu and keep your Aranet4 nearby."
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,2,2,8" />
                            <Expander Header="Bluetooth diagnostics · latest packets" Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,4,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <DockPanel Margin="0,0,0,4" LastChildFill="False">
                                        <TextBlock Text="ADVERTISEMENT" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Content="Copy" Tag="adv" Click="CopyPacket_Click" Style="{StaticResource SmallLinkButton}" />
                                    </DockPanel>
                                    <TextBox x:Name="AdvertisementText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="88"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" Background="#F7F9FC" Padding="8" Foreground="{StaticResource Ink}" />
                                    <DockPanel Margin="0,10,0,4" LastChildFill="False">
                                        <TextBlock Text="SCAN RESPONSE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Content="Copy" Tag="scan" Click="CopyPacket_Click" Style="{StaticResource SmallLinkButton}" />
                                    </DockPanel>
                                    <TextBox x:Name="ScanResponseText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="88"
                                             FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" Background="#F7F9FC" Padding="8" Foreground="{StaticResource Ink}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Metric cards: always visible; click one to chart it -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CO2 hero -->
                <RadioButton x:Name="Co2Tab" Grid.Column="0" GroupName="Metric" Tag="Co2" IsChecked="True" Style="{StaticResource HeroTab}"
                             Checked="MetricTab_Checked" ToolTip="Show the CO₂ chart">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="CARBON DIOXIDE" Foreground="#BFD5F7" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border x:Name="QualityBadge" CornerRadius="12" Padding="12,4" Visibility="Collapsed" HorizontalAlignment="Right">
                                <TextBlock x:Name="QualityText" FontWeight="Bold" FontSize="12" Foreground="#0F1B2E" />
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <TextBlock x:Name="Co2Text" Text="—" Foreground="White" FontSize="50" FontWeight="SemiBold" />
                            <TextBlock x:Name="Co2UnitText" Text="ppm" Foreground="#9DB8E0" FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Bottom" Margin="8,0,0,12" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="TrendText" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="Co2CaptionText" Text="Waiting for a live beacon" Foreground="#9DB8E0" FontSize="13" Margin="2,0,0,0"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Gauge: 400 - 2000 ppm -->
                        <Grid Margin="0,12,0,0" Height="16">
                            <Border Height="8" CornerRadius="4" VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#2EC27E" Offset="0" />
                                        <GradientStop Color="#2EC27E" Offset="0.33" />
                                        <GradientStop Color="#F5B942" Offset="0.45" />
                                        <GradientStop Color="#F5B942" Offset="0.58" />
                                        <GradientStop Color="#EF5B5B" Offset="0.70" />
                                        <GradientStop Color="#EF5B5B" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid x:Name="GaugeMarkerGrid" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="GaugeLeft" Width="0.5*" />
                                    <ColumnDefinition x:Name="GaugeRight" Width="0.5*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="16" Height="16" Fill="White" Stroke="#16294A" StrokeThickness="3"
                                         HorizontalAlignment="Right" Margin="0,0,-8,0" />
                            </Grid>
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="400" Foreground="#8FA9D0" FontSize="11" />
                            <TextBlock Text="1000" Foreground="#8FA9D0" FontSize="11" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="1" Text="1400" Foreground="#8FA9D0" FontSize="11" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="2000+" Foreground="#8FA9D0" FontSize="11" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </RadioButton>

                <!-- Temperature -->
                <RadioButton x:Name="TemperatureTab" Grid.Column="1" GroupName="Metric" Tag="Temperature" Foreground="#F97316"
                             Style="{StaticResource MetricTab}" Checked="MetricTab_Checked" ToolTip="Show the temperature chart">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#F97316" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="TEMPERATURE" Style="{StaticResource SectionLabel}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="TemperatureText" Text="—" Style="{StaticResource MetricValue}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" x:Name="TemperatureRangeText" Style="{StaticResource SubText}" />
                    </Grid>
                </RadioButton>

                <!-- Humidity -->
                <RadioButton x:Name="HumidityTab" Grid.Column="2" GroupName="Metric" Tag="Humidity" Foreground="#06B6D4"
                             Style="{StaticResource MetricTab}" Checked="MetricTab_Checked" ToolTip="Show the humidity chart">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#06B6D4" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="HUMIDITY" Style="{StaticResource SectionLabel}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="HumidityText" Text="—" Style="{StaticResource MetricValue}" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="HumidityRangeText" Style="{StaticResource SubText}" />
                            <ProgressBar x:Name="HumidityBar" Style="{StaticResource ThinBar}" Foreground="#06B6D4" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </RadioButton>

                <!-- Pressure -->
                <RadioButton x:Name="PressureTab" Grid.Column="3" GroupName="Metric" Tag="Pressure" Foreground="#8B5CF6" Margin="0"
                             Style="{StaticResource MetricTab}" Checked="MetricTab_Checked" ToolTip="Show the pressure chart">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="PRESSURE" Style="{StaticResource SectionLabel}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" x:Name="PressureText" Text="—" Style="{StaticResource MetricValue}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" x:Name="PressureRangeText" Style="{StaticResource SubText}" />
                    </Grid>
                </RadioButton>
            </Grid>

            <!-- One chart at a time -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20,14,20,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ChartDot" Width="8" Height="8" Fill="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ChartTitleText" Text="CO₂ HISTORY" Style="{StaticResource SectionLabel}" />
                            </StackPanel>
                            <TextBlock x:Name="ChartStatsText" Text="No readings yet" Foreground="{StaticResource Ink}" FontSize="14" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SyncHistoryButton" Content="Sync sensor" Style="{StaticResource SmallLinkButton}" Click="SyncHistory_Click" Margin="0,0,4,0"
                                    ToolTip="Download the sensor's stored history (CO₂, temperature, humidity and pressure)" />
                            <Button x:Name="CancelHistorySyncButton" Content="Cancel sync" Style="{StaticResource SmallLinkButton}" Click="CancelHistorySync_Click" IsEnabled="False" Margin="0,0,4,0" />
                            <Button Content="Export CSV" Style="{StaticResource SmallLinkButton}" Click="ExportCsv_Click" Margin="0,0,12,0" />
                            <Border Background="#EEF2F8" CornerRadius="11" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="1h" Tag="1" GroupName="ChartRange" Style="{StaticResource SegmentButton}" Checked="RangeButton_Checked" />
                                    <RadioButton Content="6h" Tag="6" GroupName="ChartRange" Style="{StaticResource SegmentButton}" IsChecked="True" Checked="RangeButton_Checked" />
                                    <RadioButton Content="24h" Tag="24" GroupName="ChartRange" Style="{StaticResource SegmentButton}" Checked="RangeButton_Checked" />
                                    <RadioButton Content="All" Tag="0" GroupName="ChartRange" Style="{StaticResource SegmentButton}" Checked="RangeButton_Checked" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <controls:MetricChart x:Name="HistoryChart" Grid.Row="1" Margin="0,8,0,0" MinHeight="150" />
                </Grid>
            </Border>

            <!-- Bottom strip: alert settings and sensor/system details -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="18,10" Margin="0,0,14,0">
                    <StackPanel VerticalAlignment="Center">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="CO₂ alert: notify above" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="AlertThresholdTextBox" Text="1000" Width="60" Padding="4,2" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                                     LostFocus="AlertThreshold_LostFocus" ToolTip="Ventilation alert threshold in ppm" />
                            <TextBlock Text="ppm for" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,4,0" />
                            <TextBox x:Name="AlertDurationTextBox" Text="10" Width="40" Padding="4,2" HorizontalContentAlignment="Right" VerticalAlignment="Center"
                                     LostFocus="AlertThreshold_LostFocus" ToolTip="Required sustained alert duration in minutes" />
                            <TextBlock Text="min" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0,8,0" />
                            <Button Content="Send test" Style="{StaticResource SmallLinkButton}" Click="SendTestAlert_Click" ToolTip="Preview the notification" />
                            <Button x:Name="PauseAlertsButton" Content="Pause 1 h" Style="{StaticResource SmallLinkButton}" Click="PauseAlerts_Click"
                                    ToolTip="Silence ventilation alerts for one hour" />
                        </WrapPanel>
                        <TextBlock x:Name="AlertStatusText" Foreground="#B45309" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="BATTERY" Style="{StaticResource SectionLabel}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock x:Name="BatteryText" Text="—" Style="{StaticResource SysValue}" />
                                <ProgressBar x:Name="BatteryBar" Style="{StaticResource ThinBar}" Foreground="#22C55E" Width="44" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="SIGNAL" Style="{StaticResource SectionLabel}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <controls:SignalBars x:Name="DetailSignal" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="RssiText" Text="—" Style="{StaticResource SysValue}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,28,0">
                            <TextBlock Text="READING AGE" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="AgeText" Text="—" Style="{StaticResource SysValue}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="INTERVAL" Style="{StaticResource SectionLabel}" />
                            <TextBlock x:Name="IntervalText" Text="—" Style="{StaticResource SysValue}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
