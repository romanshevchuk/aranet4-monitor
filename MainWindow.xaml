<Window x:Class="BleListener.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aranet4 Home Listener" Height="720" Width="1240" MinHeight="520" MinWidth="900">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="13,6" /><Setter Property="Margin" Value="0,0,8,0" /></Style>
        <Style TargetType="TextBlock" x:Key="ValueText"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel Margin="0,0,0,8">
                <Button x:Name="StartButton" Click="StartButton_Click">Start listening</Button>
                <Button x:Name="StopButton" Click="StopButton_Click" IsEnabled="False">Stop</Button>
                <Button Click="ClearButton_Click">Clear devices</Button>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="DarkSlateGray">Ready</TextBlock>
            </WrapPanel>
            <Border Background="#FFF7E6" BorderBrush="#F0C36D" BorderThickness="1" CornerRadius="4" Padding="9" Margin="0,0,0,12">
                <TextBlock TextWrapping="Wrap">This app only observes Aranet4 BLE broadcasts; it never pairs or connects. If a device is found but stays on “Waiting for sensor advertisement”, enable <Bold>Smart Home Integrations</Bold> in the Aranet Home app. Your captured <Bold>ScanResponse</Bold> identifies the device but does not contain a reading.</TextBlock>
            </Border>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="2*" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DataGrid x:Name="DevicesGrid" Grid.Row="0" ItemsSource="{Binding Devices}" SelectionChanged="DevicesGrid_SelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Aranet4" Binding="{Binding Name}" Width="*" MinWidth="150" />
                    <DataGridTextColumn Header="CO₂" Binding="{Binding Co2}" Width="95" />
                    <DataGridTextColumn Header="Temperature" Binding="{Binding Temperature}" Width="105" />
                    <DataGridTextColumn Header="Humidity" Binding="{Binding Humidity}" Width="85" />
                    <DataGridTextColumn Header="Pressure" Binding="{Binding Pressure}" Width="100" />
                    <DataGridTextColumn Header="Battery" Binding="{Binding Battery}" Width="75" />
                    <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="60" />
                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen, StringFormat={}{0:HH:mm:ss}}" Width="95" />
                    <DataGridTextColumn Header="State" Binding="{Binding IntegrationState}" Width="250" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" />
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <GroupBox Header="Selected Aranet4" Margin="0,8,4,0">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel><TextBlock Text="CO₂" Foreground="DimGray" /><TextBlock x:Name="Co2Text" Style="{StaticResource ValueText}" Text="—" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Temperature" Foreground="DimGray" /><TextBlock x:Name="TemperatureText" Style="{StaticResource ValueText}" Text="—" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Humidity" Foreground="DimGray" /><TextBlock x:Name="HumidityText" Style="{StaticResource ValueText}" Text="—" /></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="Pressure" Foreground="DimGray" /><TextBlock x:Name="PressureText" Style="{StaticResource ValueText}" Text="—" /></StackPanel>
                        <TextBlock x:Name="DeviceInfoText" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="DimGray">Select a device to inspect its beacon captures.</TextBlock>
                    </Grid>
                </GroupBox>
                <GroupBox Header="Latest raw BLE captures" Grid.Column="1" Margin="4,8,0,0"><TextBox x:Name="RawPacketText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" Padding="7" /></GroupBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
