<Window x:Class="BleListener.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aranet4 Home" Height="760" Width="1200" MinHeight="620" MinWidth="980"
        Background="#F4F7FB" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#162238" />
        <SolidColorBrush x:Key="Muted" Color="#66738A" />
        <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="#E3E9F2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#203453" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="BorderBrush" Value="#E3E9F2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#E8F1FF" /><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4386F5" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F7FAFF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#162238" Padding="28,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="aranet4" Foreground="#89B4FF" FontSize="14" FontWeight="Bold" />
                    <TextBlock Text="Home air dashboard" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#28476F" CornerRadius="12" Padding="12,7"><TextBlock x:Name="StatusText" Foreground="#DDEBFF" Text="Ready to listen" FontWeight="SemiBold" /></Border>
                    <Button x:Name="StartButton" Click="StartButton_Click" Style="{StaticResource OutlineButton}" Background="#4386F5">Start listener</Button>
                    <Button x:Name="StopButton" Click="StopButton_Click" Style="{StaticResource OutlineButton}" IsEnabled="False">Stop</Button>
                    <Button Click="ClearButton_Click" Style="{StaticResource OutlineButton}" Background="#28476F">Clear</Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Background="#1E3C66" BorderThickness="0" Padding="26" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CURRENT CO₂" Foreground="#BFD5F7" FontSize="13" FontWeight="Bold" />
                                <TextBlock x:Name="Co2Text" Text="—" Foreground="White" FontSize="54" FontWeight="SemiBold" Margin="0,6,0,0" />
                                <TextBlock x:Name="Co2CaptionText" Text="Waiting for a live beacon" Foreground="#D7E7FF" FontSize="14" Margin="2,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#2C568B" CornerRadius="14" Padding="15,9" VerticalAlignment="Top"><TextBlock x:Name="LastSeenText" Foreground="#E8F2FF" Text="No data yet" /></Border>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8"><StackPanel><TextBlock Text="TEMPERATURE" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="TemperatureText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="8,0,0,8"><StackPanel><TextBlock Text="HUMIDITY" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="HumidityText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,8,8,0"><StackPanel><TextBlock Text="PRESSURE" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="PressureText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="8,8,0,0"><StackPanel><TextBlock Text="BATTERY" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="BatteryText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel></Border>
                    </UniformGrid>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="MEASUREMENT AGE" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="AgeText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="INTERVAL" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="IntervalText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="SIGNAL" Style="{StaticResource MetricLabel}" /><TextBlock x:Name="RssiText" Text="—" Style="{StaticResource MetricValue}" /></StackPanel>
                        </Grid>
                        <Border Background="#F4F7FB" CornerRadius="8" Padding="10" Margin="0,18,0,0"><TextBlock x:Name="DeviceInfoText" Foreground="{StaticResource Muted}" TextWrapping="Wrap">Select a device or start listening.</TextBlock></Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="4,2,4,14">
                        <TextBlock Text="YOUR DEVICES" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="The first detected Aranet4 opens automatically." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                    <ListBox x:Name="DevicesList" ItemsSource="{Binding Devices}" SelectionChanged="DevicesList_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Address}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding IntegrationState}" Foreground="#3870C7" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Expander Grid.Row="1" Grid.ColumnSpan="2" Header="Diagnostics · latest Bluetooth packets" Margin="0,20,0,0" Foreground="{StaticResource Muted}">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="12"><TextBox x:Name="RawPacketText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="110" FontFamily="Cascadia Mono" FontSize="12" BorderThickness="0" Background="Transparent" /></Border>
            </Expander>
        </Grid>
    </Grid>
</Window>
