<Window x:Class="BleListener.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BleListener"
        Title="Aranet4 Home" Height="780" Width="1240" MinHeight="640" MinWidth="1000"
        Background="#F3F6FB" FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#162238" />
        <SolidColorBrush x:Key="Muted" Color="#66738A" />
        <SolidColorBrush x:Key="Card" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Line" Color="#E3E9F2" />
        <SolidColorBrush x:Key="Accent" Color="#3B82F6" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="#F1F5FA" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <!-- Buttons -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.7" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#22385A" />
            <Setter Property="BorderBrush" Value="#36507A" />
        </Style>
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#36507A" />
            <Setter Property="Foreground" Value="#B8C7DD" />
        </Style>
        <Style x:Key="SmallLinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="8,3" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E8F1FF" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim progress bar -->
        <Style x:Key="ThinBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="#3B82F6" />
            <Setter Property="Background" Value="#E6ECF5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Status dot (pulses while listening) -->
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="#8FA3BF" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="error"><Setter Property="Fill" Value="#EF5B5B" /></Trigger>
                <Trigger Property="Tag" Value="on">
                    <Setter Property="Fill" Value="#2EC27E" />
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="PulseStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.9"
                                                 AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="PulseStoryboard" />
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Device list items -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#F7FAFF" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#EAF2FF" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="28,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0F1B2E" Offset="0" />
                    <GradientStop Color="#1B3354" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="42" Height="42" Margin="0,0,14,0">
                        <Ellipse Stroke="#4386F5" StrokeThickness="3" />
                        <Ellipse Width="14" Height="14" Fill="#89B4FF" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="aranet4" Foreground="#89B4FF" FontSize="13" FontWeight="Bold" />
                        <TextBlock Text="Home air dashboard" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#22385A" BorderBrush="#36507A" BorderThickness="1" CornerRadius="14" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Style="{StaticResource StatusDotStyle}" />
                            <TextBlock x:Name="StatusText" Foreground="#DDEBFF" Text="Ready to listen" FontWeight="SemiBold"
                                       MaxWidth="340" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="StartButton" Click="StartButton_Click" Style="{StaticResource PrimaryButton}" Content="Start listener" />
                    <Button x:Name="StopButton" Click="StopButton_Click" Style="{StaticResource SecondaryButton}" IsEnabled="False" Content="Stop" />
                    <Button Click="ClearButton_Click" Style="{StaticResource GhostButton}" Content="Clear" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <!-- Dashboard -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,20,0">
                <StackPanel>
                    <!-- Hero: CO2 -->
                    <Border CornerRadius="18" Padding="28,24" Margin="0,0,0,16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1E3C66" Offset="0" />
                                <GradientStop Color="#16294A" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CARBON DIOXIDE" Foreground="#BFD5F7" FontSize="12" FontWeight="Bold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="Co2Text" Text="—" Foreground="White" FontSize="64" FontWeight="SemiBold" />
                                        <TextBlock x:Name="Co2UnitText" Text="ppm" Foreground="#9DB8E0" FontSize="20" FontWeight="SemiBold"
                                                   VerticalAlignment="Bottom" Margin="8,0,0,14" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock x:Name="Co2CaptionText" Text="Waiting for a live beacon" Foreground="#D7E7FF" FontSize="14" Margin="2,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <Border x:Name="QualityBadge" CornerRadius="14" Padding="14,7" Visibility="Collapsed" HorizontalAlignment="Right">
                                        <TextBlock x:Name="QualityText" FontWeight="Bold" FontSize="13" Foreground="#0F1B2E" />
                                    </Border>
                                    <Border Background="#2C568B" CornerRadius="14" Padding="14,7" Margin="0,8,0,0" HorizontalAlignment="Right">
                                        <TextBlock x:Name="LastSeenText" Foreground="#E8F2FF" FontSize="12" Text="No data yet" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Gauge: 400 - 2000 ppm -->
                            <Grid Margin="0,22,0,0" Height="16">
                                <Border Height="8" CornerRadius="4" VerticalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2EC27E" Offset="0" />
                                            <GradientStop Color="#2EC27E" Offset="0.33" />
                                            <GradientStop Color="#F5B942" Offset="0.45" />
                                            <GradientStop Color="#F5B942" Offset="0.58" />
                                            <GradientStop Color="#EF5B5B" Offset="0.70" />
                                            <GradientStop Color="#EF5B5B" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Grid x:Name="GaugeMarkerGrid" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="GaugeLeft" Width="0.5*" />
                                        <ColumnDefinition x:Name="GaugeRight" Width="0.5*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="16" Height="16" Fill="White" Stroke="#16294A" StrokeThickness="3"
                                             HorizontalAlignment="Right" Margin="0,0,-8,0" />
                                </Grid>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="400" Foreground="#7F9CC8" FontSize="11" />
                                <TextBlock Text="1000" Foreground="#7F9CC8" FontSize="11" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="1" Text="1400" Foreground="#7F9CC8" FontSize="11" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="2000+" Foreground="#7F9CC8" FontSize="11" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Metric tiles -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#F97316" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="TEMPERATURE" Style="{StaticResource SectionLabel}" />
                                </StackPanel>
                                <TextBlock x:Name="TemperatureText" Text="—" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#06B6D4" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="HUMIDITY" Style="{StaticResource SectionLabel}" />
                                </StackPanel>
                                <TextBlock x:Name="HumidityText" Text="—" Style="{StaticResource MetricValue}" />
                                <ProgressBar x:Name="HumidityBar" Style="{StaticResource ThinBar}" Foreground="#06B6D4" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="PRESSURE" Style="{StaticResource SectionLabel}" />
                                </StackPanel>
                                <TextBlock x:Name="PressureText" Text="—" Style="{StaticResource MetricValue}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#22C55E" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="BATTERY" Style="{StaticResource SectionLabel}" />
                                </StackPanel>
                                <TextBlock x:Name="BatteryText" Text="—" Style="{StaticResource MetricValue}" />
                                <ProgressBar x:Name="BatteryBar" Style="{StaticResource ThinBar}" Foreground="#22C55E" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Connection details -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="MEASUREMENT AGE" Style="{StaticResource SectionLabel}" />
                                    <TextBlock x:Name="AgeText" Text="—" Style="{StaticResource MetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="INTERVAL" Style="{StaticResource SectionLabel}" />
                                    <TextBlock x:Name="IntervalText" Text="—" Style="{StaticResource MetricValue}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SIGNAL" Style="{StaticResource SectionLabel}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <local:SignalBars x:Name="DetailSignal" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock x:Name="RssiText" Text="—" Foreground="{StaticResource Ink}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,18,0,14" />
                            <WrapPanel>
                                <Border Style="{StaticResource Chip}"><TextBlock x:Name="InfoNameText" Text="No device selected" Foreground="{StaticResource Ink}" FontSize="12" FontWeight="SemiBold" /></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock x:Name="InfoAddressText" Text="Address —" Foreground="{StaticResource Muted}" FontSize="12" FontFamily="Cascadia Mono, Consolas" /></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock x:Name="InfoFirmwareText" Text="Firmware —" Foreground="{StaticResource Muted}" FontSize="12" /></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock x:Name="InfoPacketsText" Text="0 packets" Foreground="{StaticResource Muted}" FontSize="12" /></Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Devices -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,2,4,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="YOUR DEVICES" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="The first detected Aranet4 opens automatically." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#EAF2FF" CornerRadius="10" Padding="9,3" VerticalAlignment="Top">
                            <TextBlock x:Name="DevicesCountText" Text="0" Foreground="#2F6FDD" FontWeight="Bold" FontSize="12" />
                        </Border>
                    </Grid>
                    <Grid>
                        <ListBox x:Name="DevicesList" ItemsSource="{Binding Devices}" SelectionChanged="DevicesList_SelectionChanged"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="10" Height="10" Margin="0,5,10,0" VerticalAlignment="Top">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#B6C2D3" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLive}" Value="True"><Setter Property="Fill" Value="#2EC27E" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Address}" Foreground="{StaticResource Muted}" FontSize="11" FontFamily="Cascadia Mono, Consolas" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding IntegrationState}" Foreground="#3870C7" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Right">
                                            <local:SignalBars Bars="{Binding SignalBars}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding LastSeenAgo}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0" IsHitTestVisible="False">
                            <Grid Width="56" Height="56" HorizontalAlignment="Center">
                                <Ellipse Stroke="#CBD5E1" StrokeThickness="2" StrokeDashArray="3 3" />
                                <Ellipse Width="12" Height="12" Fill="#CBD5E1" />
                            </Grid>
                            <TextBlock Text="No devices yet" Foreground="{StaticResource Ink}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock x:Name="EmptyHintText" Text="Press “Start listener” and keep your Aranet4 nearby."
                                       Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Diagnostics -->
            <Expander Grid.Row="1" Grid.ColumnSpan="2" Header="Diagnostics · latest Bluetooth packets" Margin="0,18,0,0"
                      Foreground="{StaticResource Muted}" FontWeight="SemiBold">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="14,10,14,12" Margin="0,0,8,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                                <TextBlock Text="ADVERTISEMENT" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Copy" Tag="adv" Click="CopyPacket_Click" Style="{StaticResource SmallLinkButton}" />
                            </DockPanel>
                            <TextBox x:Name="AdvertisementText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="130"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" Background="#F7F9FC" Padding="8" Foreground="{StaticResource Ink}" />
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14,10,14,12" Margin="8,0,0,0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                                <TextBlock Text="SCAN RESPONSE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Copy" Tag="scan" Click="CopyPacket_Click" Style="{StaticResource SmallLinkButton}" />
                            </DockPanel>
                            <TextBox x:Name="ScanResponseText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="130"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" Background="#F7F9FC" Padding="8" Foreground="{StaticResource Ink}" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Expander>
        </Grid>
    </Grid>
</Window>
