<UserControl x:Class="Aranet4Monitor.Presentation.Views.History.DayStripSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Margin="0,12,0,8">
            <TextBlock Text="Day at a glance"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="14"
                       FontWeight="SemiBold"/>
            <TextBlock Text="One stripe every 20 minutes · ● airing detected"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="12"
                       Margin="0,2,0,0"/>
        </StackPanel>
        <UniformGrid x:Name="Cells"
                     Rows="1"
                     Columns="72"
                     Height="48"
                     AutomationProperties.Name="CO₂ levels and airing events over the last 24 hours"/>
        <Grid Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StartTimeText"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11"/>
            <TextBlock x:Name="QuarterTimeText"
                       Grid.Column="1"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11"/>
            <TextBlock x:Name="HalfTimeText"
                       Grid.Column="2"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11"/>
            <TextBlock x:Name="ThreeQuarterTimeText"
                       Grid.Column="3"
                       TextAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11"/>
            <TextBlock Text="Now"
                       Grid.Column="4"
                       TextAlignment="Right"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="11"/>
        </Grid>
    </StackPanel>
</UserControl>
