<UserControl x:Class="Aranet4Monitor.Presentation.Views.History.HistorySidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Card"
            Style="{StaticResource CardStyle}"
            Padding="18">
        <StackPanel>
            <TextBlock Text="Time in each zone"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="{StaticResource FontSizeEmphasis}"
                       FontWeight="SemiBold"/>
            <Grid x:Name="ZoneShareBar"
                  Height="12"
                  Margin="0,12,0,8"
                  ClipToBounds="True"/>
            <TextBlock x:Name="ZoneShareText"
                       Text="No readings yet"
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"/>
            <Border Height="1"
                    Background="{DynamicResource Border}"
                    Margin="0,16,0,14"/>
            <TextBlock Text="Worth knowing"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="{StaticResource FontSizeEmphasis}"
                       FontWeight="SemiBold"/>
            <TextBlock x:Name="OvernightText"
                       Text="Overnight: no readings yet."
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource GapSmallTop}"/>
            <TextBlock x:Name="AiringText"
                       Text="Airing was not detected in the last 24 hours."
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource GapSmallTop}"/>
            <TextBlock x:Name="PeakText"
                       Text="Highest: no readings yet."
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       Margin="{StaticResource GapSmallTop}"/>
            <Border Height="1"
                    Background="{DynamicResource Border}"
                    Margin="0,16,0,14"/>
            <TextBlock Text="Export"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="{StaticResource FontSizeEmphasis}"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Raw measurements for the selected range."
                       Foreground="{DynamicResource TextSecondary}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,10"/>
            <Button x:Name="ExportButton"
                    Content="Export CSV"
                    Tag="visible"
                    Style="{StaticResource GhostButton}"
                    Click="ExportButton_Click"/>
        </StackPanel>
    </Border>
</UserControl>
