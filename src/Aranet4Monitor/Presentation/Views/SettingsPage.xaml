<UserControl x:Class="Aranet4Monitor.Presentation.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">
    <ScrollViewer x:Name="SettingsScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="26,24,26,24">
            <StackPanel MaxWidth="860"
                        HorizontalAlignment="Center">
                <TextBlock Text="Settings"
                           Foreground="{DynamicResource TextPrimary}"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Adjust CO₂ alerts, display preferences, and tray behavior. Your readings and settings stay on this PC; no account or cloud service is used."
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="NOTIFICATIONS"
                                   Style="{StaticResource SectionLabel}"/>
                        <Border BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,0,0,1"
                                Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CO₂ alert threshold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Notify after sustained readings above this value."
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,16,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBox Width="78"
                                             Style="{StaticResource NumberInput}"
                                             Text="{Binding AlertThresholdPpm, UpdateSourceTrigger=LostFocus}"
                                             HorizontalContentAlignment="Right"
                                             AutomationProperties.Name="CO₂ alert threshold in parts per million"/>
                                    <TextBlock Text="ppm for"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,6,0"/>
                                    <TextBox Width="50"
                                             Style="{StaticResource NumberInput}"
                                             Text="{Binding AlertDurationMinutes, UpdateSourceTrigger=LostFocus}"
                                             HorizontalContentAlignment="Right"
                                             AutomationProperties.Name="CO₂ alert duration in minutes"/>
                                    <TextBlock Text="min"
                                               Foreground="{DynamicResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="5,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,0,0,1"
                                Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Test notification"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Send a preview using your current alert settings."
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,16,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="Send test notification"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding TestNotificationCommand}"/>
                            </Grid>
                        </Border>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding AlertStatus}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button Grid.Column="1"
                                    Content="{Binding SnoozeButtonText}"
                                    Style="{StaticResource SmallLinkButton}"
                                    Command="{Binding SnoozeCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="DISPLAY"
                                   Style="{StaticResource SectionLabel}"/>
                        <Border BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,0,0,1"
                                Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Temperature unit"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource SurfaceSecondary}"
                                        CornerRadius="8"
                                        Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="°C"
                                                     GroupName="TemperatureUnit"
                                                     Style="{StaticResource SegmentButton}"
                                                     IsChecked="{Binding IsCelsius, Mode=TwoWay}"/>
                                        <RadioButton Content="°F"
                                                     GroupName="TemperatureUnit"
                                                     Style="{StaticResource SegmentButton}"
                                                     IsChecked="{Binding IsFahrenheit, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,0,0,1"
                                Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Appearance"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource SurfaceSecondary}"
                                        CornerRadius="8"
                                        Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Auto"
                                                     GroupName="Appearance"
                                                     Style="{StaticResource SegmentButton}"
                                                     IsChecked="{Binding IsAutoTheme, Mode=TwoWay}"/>
                                        <RadioButton Content="Light"
                                                     GroupName="Appearance"
                                                     Style="{StaticResource SegmentButton}"
                                                     IsChecked="{Binding IsLightTheme, Mode=TwoWay}"/>
                                        <RadioButton Content="Dark"
                                                     GroupName="Appearance"
                                                     Style="{StaticResource SegmentButton}"
                                                     IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,0,0,1"
                                Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Large pop-ups"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Show notifications in the app's larger pop-up window."
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,16,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding LargePopups, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Use large notification pop-ups"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="TRAY AND STARTUP"
                                   Style="{StaticResource SectionLabel}"/>
                        <Border BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,0,0,1"
                                Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Show CO₂ number in tray icon"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding ShowNumberInTray, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Show CO₂ number in tray icon"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource Line}"
                                BorderThickness="0,0,0,1"
                                Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Listen for live readings"
                                               Foreground="{DynamicResource TextPrimary}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Keep the sensor listener running while the app is open."
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,16,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding ListenForLiveReadings, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Listen for live sensor readings"/>
                            </Grid>
                        </Border>
                        <Border Padding="0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start with Windows"
                                           Foreground="{DynamicResource TextPrimary}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.Name="Start Air Pulse with Windows"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="LOCAL DATA AND SENSOR"
                                   Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="History and preferences stay on this PC. Export readings from History; forgetting detected devices does not delete saved history."
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Forget detected devices…"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding ForgetDetectedDevicesCommand}"/>
                            <Button Content="Bluetooth diagnostics"
                                    Style="{StaticResource SmallLinkButton}"
                                    Command="{Binding OpenBluetoothDiagnosticsCommand}"
                                    Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
