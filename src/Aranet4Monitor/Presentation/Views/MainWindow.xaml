<Window x:Class="Aranet4Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aranet4Monitor"
        xmlns:controls="clr-namespace:Aranet4Monitor.Presentation.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Aranet4 Monitor"
        Height="760"
        Width="1200"
        MinHeight="640"
        MinWidth="760"
        WindowStyle="None"
        ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged"
        Background="{StaticResource AppBackground}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="74"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Margin="8"
            Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="20"
            ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: brand, device chip, status, menu -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Padding="22,17"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Grid Width="30"
                              Height="30"
                              Margin="0,0,12,0">
                            <Ellipse Stroke="{StaticResource Co2Good}"
                                     StrokeThickness="2.5"/>
                            <Ellipse Width="10"
                                     Height="10"
                                     Fill="{StaticResource Co2Good}"/>
                        </Grid>
                        <TextBlock Text="Air Pulse"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,12,0">
                        <Button x:Name="LiveNavigationButton"
                                Content="Live"
                                Style="{StaticResource HeaderNavigationSelectedButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="LiveNavigation_Click"
                                AutomationProperties.Name="Show live dashboard"/>
                        <Button x:Name="HistoryNavigationButton"
                                Content="History"
                                Style="{StaticResource HeaderNavigationButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="HistoryNavigation_Click"
                                AutomationProperties.Name="Show sensor history chart"/>
                        <Button x:Name="SettingsNavigationButton"
                                Content="Settings"
                                Style="{StaticResource HeaderNavigationButton}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="SettingsNavigation_Click"
                                ToolTip="Application settings and options"
                                AutomationProperties.Name="Open settings"/>
                    </StackPanel>

                    <Button x:Name="DeviceChipButton"
                            Grid.Column="3"
                            Style="{StaticResource DeviceChip}"
                            MinWidth="170"
                            HorizontalAlignment="Right"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="DeviceChip_Click"
                            ToolTip="Sensor details and device list">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DeviceDot"
                                     Width="9"
                                     Height="9"
                                     Fill="{StaticResource Muted}"
                                     Margin="0,0,9,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="ChipNameText"
                                       Text="Searching for sensor…"
                                       MaxWidth="125"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="▾"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <StackPanel x:Name="SyncProgressPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    Margin="8,0,0,0">
                            <ProgressBar Width="24"
                                         Height="4"
                                         IsIndeterminate="True"
                                         Foreground="{StaticResource Co2Good}"
                                         Background="{StaticResource Border}"/>
                            <TextBlock x:Name="SyncStatusText"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       MaxWidth="190"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="CancelHistorySyncButton"
                                Content="Cancel"
                                Style="{StaticResource HeaderActionButton}"
                                Click="CancelHistorySync_Click"
                                IsEnabled="False"
                                Visibility="Collapsed"
                                Margin="6,0,0,0"/>
                    </StackPanel>

                    <Button x:Name="MoreButton"
                            Grid.Column="5"
                            Style="{StaticResource UtilityButton}"
                            Width="36"
                            Padding="0"
                            FontSize="16"
                            Content="⋯"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Click="MoreButton_Click"
                            ToolTip="Settings and options"
                            AutomationProperties.Name="Settings and options">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="MoreMenu"
                                         Placement="Bottom">
                                <MenuItem Header="Minimize window"
                                          Click="MinimizeWindow_Click" />
                                <MenuItem Header="Maximize or restore window"
                                          Click="ToggleWindowState_Click" />
                                <Separator />
                                <MenuItem Header="Alert settings…"
                                          Click="OpenAlertSettings_Click"/>
                                <MenuItem Header="Export CSV">
                                    <MenuItem Header="Visible range"
                                              Tag="visible"
                                              Click="ExportCsv_Click"/>
                                    <MenuItem Header="All"
                                              Tag="all"
                                              Click="ExportCsv_Click"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Temperature unit">
                                    <MenuItem x:Name="CelsiusUnitMenuItem"
                                              Header="Celsius (°C)"
                                              Tag="Celsius"
                                              IsCheckable="True"
                                              Click="TemperatureUnit_Click"/>
                                    <MenuItem x:Name="FahrenheitUnitMenuItem"
                                              Header="Fahrenheit (°F)"
                                              Tag="Fahrenheit"
                                              IsCheckable="True"
                                              Click="TemperatureUnit_Click"/>
                                </MenuItem>
                                <MenuItem x:Name="ListenMenuItem"
                                          Header="Listen for live readings"
                                          IsCheckable="True"
                                          Click="ListenMenuItem_Click"/>
                                <MenuItem x:Name="ShowNumberMenuItem"
                                          Header="Show number in tray icon"
                                          IsCheckable="True"
                                          Click="ShowNumberMenuItem_Click"/>
                                <MenuItem x:Name="LargePopupsMenuItem"
                                          Header="Large pop-ups"
                                          IsCheckable="True"
                                          Click="LargePopupsMenuItem_Click"/>
                                <MenuItem x:Name="StartWithWindowsMenuItem"
                                          Header="Start with Windows"
                                          IsCheckable="True"
                                          Click="StartWithWindowsMenuItem_Click"/>
                                <MenuItem Header="Bluetooth diagnostics"
                                          Click="BluetoothDiagnostics_Click"/>
                                <Separator/>
                                <MenuItem Header="Forget detected devices…"
                                          Foreground="{StaticResource Danger}"
                                          Click="ClearButton_Click"/>
                                <MenuItem Header="Exit Aranet4 Monitor"
                                          ToolTip="Closing the window keeps the app running in the tray."
                                          Click="ExitMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- Device list + Bluetooth diagnostics: out of the way until wanted -->
                    <Popup x:Name="DevicePopup"
                           PlacementTarget="{Binding ElementName=DeviceChipButton}"
                           Placement="Bottom"
                           DataContext="{Binding DataContext, ElementName=DeviceChipButton}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           Closed="DevicePopup_Closed">
                        <Border Width="420"
                                Margin="12,4,18,18"
                                Style="{StaticResource PopoverCard}"
                                Padding="16"
                                PreviewKeyDown="DevicePopup_PreviewKeyDown">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="3"
                                                  Opacity="0.25"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="2,0,2,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DevicesTitleText"
                                               Text="SENSOR"
                                               Foreground="{StaticResource Ink}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="1"
                                            Background="{StaticResource SurfaceSelected}"
                                            CornerRadius="10"
                                            Padding="9,2">
                                        <TextBlock x:Name="DevicesCountText"
                                                   Text="0"
                                                   Foreground="{StaticResource Accent}"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>
                                </Grid>
                                <ListBox x:Name="DevicesList"
                                         ItemsSource="{Binding Devices}"
                                         SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                         SelectionChanged="DevicesList_SelectionChanged"
                                         MaxHeight="230"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10"
                                                         Height="10"
                                                         Margin="0,5,10,0"
                                                         VerticalAlignment="Top">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill"
                                                                    Value="{StaticResource Disabled}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLive}"
                                                                             Value="True">
                                                                    <Setter Property="Fill"
                                                                            Value="{StaticResource Positive}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           Foreground="{StaticResource Ink}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="DeviceDetailsPanel"
                                            Margin="0,8,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="DeviceStatusDot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="{StaticResource Muted}"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DeviceStatusText"
                                                   Text="Waiting for a sensor"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="Last measurement"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,10,0,0"/>
                                    <TextBlock x:Name="DeviceLastMeasurementText"
                                               Text="—"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Measurement age"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock x:Name="DeviceMeasurementAgeText"
                                               Text="—"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Battery"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,8,0,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="BatteryText"
                                                   Text="—"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="BatteryBar"
                                                     Style="{StaticResource ThinBar}"
                                                     Foreground="{StaticResource Co2Good}"
                                                     Width="64"
                                                     Margin="10,0,0,0"
                                                     VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Signal"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,8,0,0"/>
                                    <StackPanel Orientation="Horizontal">
                                        <controls:SignalBars Bars="{Binding SelectedDevice.SignalBars}"/>
                                        <TextBlock Text="{Binding SelectedDevice.Rssi, StringFormat={}{0} dBm}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="Measurement interval"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock x:Name="DeviceIntervalText"
                                               Text="—"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Firmware"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="{Binding SelectedDevice.Firmware}"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Address"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,8,0,0"/>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock x:Name="DeviceAddressText"
                                                   Text="—"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center"/>
                                        <Button DockPanel.Dock="Right"
                                                Content="Copy"
                                                Click="CopyAddress_Click"
                                                Style="{StaticResource SmallLinkButton}"
                                                ToolTip="Copy address"/>
                                    </DockPanel>
                                    <TextBlock Text="Last synced"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock x:Name="DeviceLastSyncedText"
                                               Text="Not synced yet"
                                               Foreground="{StaticResource TextPrimary}"/>
                                    <Button Content="Sync history"
                                            Style="{StaticResource HeaderActionButton}"
                                            HorizontalAlignment="Left"
                                            Click="SyncHistory_Click"
                                            Margin="0,12,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="EmptyHintText"
                                           Text="Looking for your Aranet4… Make sure Smart Home Integration is enabled in the Aranet Home app."
                                           Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap"
                                           Margin="2,2,2,8"/>
                                <Expander x:Name="DiagnosticsExpander"
                                          Header="Advanced · Bluetooth diagnostics"
                                          Foreground="{StaticResource TextSecondary}"
                                          FontWeight="SemiBold"
                                          Margin="0,4,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="PacketCountText"
                                                   Text="0 packets received"
                                                   Foreground="{StaticResource Muted}"
                                                   Margin="0,0,0,8"/>
                                        <DockPanel Margin="0,0,0,4"
                                                   LastChildFill="False">
                                            <TextBlock Text="ADVERTISEMENT"
                                                       Style="{StaticResource SectionLabel}"
                                                       VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right"
                                                    Content="Copy"
                                                    Tag="adv"
                                                    Click="CopyPacket_Click"
                                                    Style="{StaticResource SmallLinkButton}"
                                                    ToolTip="Copy advertisement packet"/>
                                        </DockPanel>
                                        <TextBox x:Name="AdvertisementText"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Height="88"
                                                 FontFamily="Cascadia Mono, Consolas"
                                                 FontSize="12"
                                                 BorderThickness="0"
                                                 Background="{StaticResource SurfaceSecondary}"
                                                 Padding="8"
                                                 Foreground="{StaticResource Ink}"/>
                                        <DockPanel Margin="0,10,0,4"
                                                   LastChildFill="False">
                                            <TextBlock Text="SCAN RESPONSE"
                                                       Style="{StaticResource SectionLabel}"
                                                       VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right"
                                                    Content="Copy"
                                                    Tag="scan"
                                                    Click="CopyPacket_Click"
                                                    Style="{StaticResource SmallLinkButton}"
                                                    ToolTip="Copy scan response packet"/>
                                        </DockPanel>
                                        <TextBox x:Name="ScanResponseText"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Height="88"
                                                 FontFamily="Cascadia Mono, Consolas"
                                                 FontSize="12"
                                                 BorderThickness="0"
                                                 Background="{StaticResource SurfaceSecondary}"
                                                 Padding="8"
                                                 Foreground="{StaticResource Ink}"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="AlertSettingsPopup"
                           PlacementTarget="{Binding ElementName=MoreButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Width="360"
                                Margin="8"
                                Style="{StaticResource PopoverCard}">
                            <StackPanel>
                                <TextBlock Text="Alert settings"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <WrapPanel VerticalAlignment="Center"
                                           Margin="0,12,0,0">
                                    <TextBlock Text="Notify above"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBox x:Name="AlertThresholdTextBox"
                                             Style="{StaticResource NumberInput}"
                                             Text="1500"
                                             Width="64"
                                             Padding="4,2"
                                             HorizontalContentAlignment="Right"
                                             VerticalAlignment="Center"
                                             LostFocus="AlertThreshold_LostFocus"
                                             ToolTip="Ventilation alert threshold in ppm"/>
                                    <TextBlock Text="ppm for"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="6,0,4,0"/>
                                    <TextBox x:Name="AlertDurationTextBox"
                                             Style="{StaticResource NumberInput}"
                                             Text="10"
                                             Width="44"
                                             Padding="4,2"
                                             HorizontalContentAlignment="Right"
                                             VerticalAlignment="Center"
                                             LostFocus="AlertThreshold_LostFocus"
                                             ToolTip="Required sustained alert duration in minutes"/>
                                    <TextBlock Text="min"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"/>
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Send test"
                                            Style="{StaticResource SmallLinkButton}"
                                            Click="SendTestAlert_Click"
                                            ToolTip="Preview the notification"/>
                                    <Button x:Name="PauseAlertsButton"
                                            Content="Pause 1 h"
                                            Style="{StaticResource SmallLinkButton}"
                                            Click="PauseAlerts_Click"
                                            ToolTip="Silence ventilation alerts for one hour"/>
                                </WrapPanel>
                                <TextBlock x:Name="AlertStatusText"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <Border x:Name="NoticeBar"
                    Grid.Row="1"
                    Style="{StaticResource StatusBanner}"
                    Margin="22,0,22,10"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NoticeText"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Button x:Name="NoticeActionButton"
                                Content="Start listening"
                                Style="{StaticResource SmallLinkButton}"
                                Click="NoticeAction_Click"/>
                        <Button x:Name="BluetoothSettingsButton"
                                Content="Bluetooth settings"
                                Style="{StaticResource SmallLinkButton}"
                                Click="BluetoothSettings_Click"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="SyncProblemBanner"
                    Grid.Row="2"
                    Style="{StaticResource StatusBanner}"
                    Margin="22,0,22,10"
                    Background="{StaticResource DangerBackground}"
                    BorderBrush="{StaticResource Danger}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SyncProblemText"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Button Content="Retry"
                                Style="{StaticResource SmallLinkButton}"
                                Click="RetrySync_Click"/>
                        <Button Content="Dismiss"
                                Style="{StaticResource SmallLinkButton}"
                                Click="DismissSyncProblem_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer x:Name="DashboardScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
        <Grid x:Name="DashboardGrid"
              Grid.Row="0"
              Margin="26,24,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.82*" MinWidth="330"/>
                <ColumnDefinition Width="1.45*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- CO₂ hero card -->
            <Grid x:Name="Co2HeroPanel"
                  Grid.Row="0"
                  Grid.Column="0"
                  Margin="0,0,16,14"
                  AutomationProperties.Name="Chart shows">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <RadioButton x:Name="Co2Tab"
                             Grid.Row="0"
                             Margin="0"
                             GroupName="Metric"
                             Tag="Co2"
                             IsChecked="True"
                             Style="{StaticResource HeroTab}"
                             Checked="MetricTab_Checked"
                             ToolTip="Show CO₂ history"
                             AutomationProperties.Name="CO₂, no reading, show history">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                        <Grid>
                            <Border x:Name="QualityBadge"
                                    CornerRadius="99"
                                    Padding="12,4"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="QualityIcon"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimary}"
                                               Margin="0,0,6,0"/>
                                    <TextBlock x:Name="QualityText"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="{StaticResource TextPrimary}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Co2Text"
                                       Text="–"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="118"
                                       FontWeight="Light"/>
                            <TextBlock x:Name="Co2UnitText"
                                       Text="ppm CO₂"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="18"
                                       FontWeight="Medium"
                                       VerticalAlignment="Bottom"
                                       Margin="8,0,0,12"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock x:Name="TrendText"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Margin="2,0,0,0"
                                   Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="Co2CaptionText"
                                   Text="Waiting for your first live reading, or sync history to download stored readings."
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   Margin="2,0,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="Co2AdviceText"
                                   FontSize="13"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource TextSecondary}"
                                   Margin="2,4,0,0"
                                   Visibility="Visible"/>

                        <!-- Gauge: 400 - 2000 ppm -->
                        <Grid x:Name="GaugeBar"
                              Margin="0,24,0,0"
                              Height="16">
                            <Border Height="8"
                                    CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0"
                                                         EndPoint="1,0">
                                        <GradientStop Color="{StaticResource Co2GoodColor}"
                                                      Offset="0"/>
                                        <GradientStop Color="{StaticResource Co2GoodColor}"
                                                      Offset="0.375"/>
                                        <GradientStop Color="{StaticResource Co2FairColor}"
                                                      Offset="0.375"/>
                                        <GradientStop Color="{StaticResource Co2FairColor}"
                                                      Offset="0.625"/>
                                        <GradientStop Color="{StaticResource Co2PoorColor}"
                                                      Offset="0.625"/>
                                        <GradientStop Color="{StaticResource Co2PoorColor}"
                                                      Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid x:Name="GaugeMarkerGrid"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="GaugeLeft"
                                                      Width="0.5*"/>
                                    <ColumnDefinition x:Name="GaugeRight"
                                                      Width="0.5*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="16"
                                         Height="16"
                                         Fill="White"
                                         Stroke="{StaticResource TextPrimary}"
                                         StrokeThickness="3"
                                         HorizontalAlignment="Right"
                                         Margin="0,0,-8,0"/>
                            </Grid>
                            <Grid IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="1"
                                        Background="{StaticResource Border}"
                                        HorizontalAlignment="Right"/>
                                <Border Grid.Column="1"
                                        Width="1"
                                        Background="{StaticResource Border}"
                                        HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>
                        <Canvas x:Name="GaugeNumberCanvas"
                                Width="{Binding ActualWidth, ElementName=GaugeBar}"
                                Height="16"
                                Margin="0,6,0,0"
                                SizeChanged="GaugeNumberCanvas_SizeChanged">
                            <TextBlock x:Name="Gauge400Label"
                                       Text="400"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       SizeChanged="GaugeNumberLabel_SizeChanged"/>
                            <TextBlock x:Name="Gauge1000Label"
                                       Text="1,000"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       SizeChanged="GaugeNumberLabel_SizeChanged"/>
                            <TextBlock x:Name="Gauge1400Label"
                                       Text="1,400"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       SizeChanged="GaugeNumberLabel_SizeChanged"/>
                            <TextBlock x:Name="Gauge2000Label"
                                       Text="2,000+"
                                       Visibility="Collapsed"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       SizeChanged="GaugeNumberLabel_SizeChanged"/>
                        </Canvas>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="600*"/>
                                <ColumnDefinition Width="400*"/>
                                <ColumnDefinition Width="600*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GoodZoneText"
                                       Text="Good"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock x:Name="FairZoneText"
                                       Grid.Column="1"
                                       Text="Elevated"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock x:Name="PoorZoneText"
                                       Grid.Column="2"
                                       Text="High"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        </StackPanel>
                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                Padding="0,14,0,0"
                                BorderBrush="{StaticResource Border}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock x:Name="Co2DayShareText"
                                               Text="—"
                                               Foreground="{StaticResource Ink}"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="Co2DayShareDetailText"
                                               Text="Good · 24 h"
                                               Style="{StaticResource SubText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock x:Name="Co2DayPeakText"
                                               Text="—"
                                               Foreground="{StaticResource Ink}"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="Co2DayPeakTimeText"
                                               Text="No readings"
                                               Style="{StaticResource SubText}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock x:Name="Co2AiringTimeText"
                                               Text="—"
                                               Foreground="{StaticResource Ink}"
                                               FontSize="17"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="Co2AiringDetailText"
                                               Text="No clear drop detected"
                                               Style="{StaticResource SubText}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </RadioButton>

            </Grid>

            <!-- One chart at a time -->
            <Border x:Name="HistoryChartCard"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Padding="20,14,20,10"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ChartDot"
                                         Width="8"
                                         Height="8"
                                         Fill="{StaticResource Co2Good}"
                                         Margin="0,0,8,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                                <TextBlock x:Name="ChartTitleText"
                                           Text="CO₂"
                                           Foreground="{StaticResource Ink}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="ChartStatsText"
                                       Text="No readings yet"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border Background="{StaticResource SurfaceSecondary}"
                                    CornerRadius="10"
                                    Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="1h"
                                                 Tag="1"
                                                 GroupName="ChartRange"
                                                 Style="{StaticResource SegmentButton}"
                                                 IsChecked="True"
                                                 Checked="RangeButton_Checked"/>
                                    <RadioButton Content="6h"
                                                 Tag="6"
                                                 GroupName="ChartRange"
                                                 Style="{StaticResource SegmentButton}"
                                                 Checked="RangeButton_Checked"/>
                                    <RadioButton Content="24h"
                                                 Tag="24"
                                                 GroupName="ChartRange"
                                                 Style="{StaticResource SegmentButton}"
                                                 Checked="RangeButton_Checked"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <controls:MetricChart x:Name="HistoryChart"
                                          Grid.Row="1"
                                          Margin="0,8,0,0"
                                          MinHeight="150"
                                          Focusable="True"
                                          KeyboardNavigation.IsTabStop="True"
                                          AutomationProperties.Name="CO₂ history chart"
                                          AutomationProperties.HelpText="Use the left and right arrow keys to inspect readings. Home and End move to the first and latest readings."/>
                    <Border Grid.Row="2"
                            Margin="0,8,0,0"
                            Padding="0,9,0,0"
                            BorderBrush="{StaticResource Border}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ChartContextDot"
                                     Width="7"
                                     Height="7"
                                     Fill="{StaticResource Co2Good}"
                                     Margin="0,5,8,0"
                                     VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="ChartContextTitleText"
                                           Text="Outdoor reference · about 420 ppm"
                                           Foreground="{StaticResource Ink}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="ChartContextText"
                                           Text="CO₂ is a ventilation signal; it does not measure particles or VOCs."
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>



            <!-- Secondary metrics stay selectable and share one compact row. -->
            <Grid x:Name="SecondaryMetricsGrid"
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,14"
                  AutomationProperties.Name="Other sensor metrics">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="TemperatureTab"
                             Grid.Row="0"
                             Grid.Column="0"
                             GroupName="Metric"
                             Tag="Temperature"
                             Foreground="{StaticResource TemperatureAccent}"
                             Style="{StaticResource MetricTab}"
                             Margin="0,0,14,0"
                             Checked="MetricTab_Checked"
                             ToolTip="Show temperature history"
                             AutomationProperties.Name="Temperature, no reading, show history">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Temperature"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TemperatureText"
                                       Text="—"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="31"
                                       FontWeight="Normal"/>
                            <TextBlock x:Name="TemperatureUnitText"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="14"
                                       VerticalAlignment="Bottom"
                                       Margin="4,0,0,5"/>
                        </StackPanel>
                        <TextBlock x:Name="TemperatureRangeText"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="HumidityTab"
                             Grid.Row="0"
                             Grid.Column="1"
                             GroupName="Metric"
                             Tag="Humidity"
                             Foreground="{StaticResource HumidityAccent}"
                             Style="{StaticResource MetricTab}"
                             Margin="0,0,14,0"
                             Checked="MetricTab_Checked"
                             ToolTip="Show humidity history"
                             AutomationProperties.Name="Humidity, no reading, show history">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Humidity"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="HumidityText"
                                       Text="—"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="31"
                                       FontWeight="Normal"/>
                            <TextBlock x:Name="HumidityUnitText"
                                       Text="%"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="14"
                                       VerticalAlignment="Bottom"
                                       Margin="4,0,0,5"/>
                        </StackPanel>
                        <TextBlock x:Name="HumidityRangeText"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="PressureTab"
                             Grid.Row="0"
                             Grid.Column="2"
                             GroupName="Metric"
                             Tag="Pressure"
                             Foreground="{StaticResource PressureAccent}"
                             Margin="0"
                             Style="{StaticResource MetricTab}"
                             Checked="MetricTab_Checked"
                             ToolTip="Show pressure history"
                             AutomationProperties.Name="Pressure, no reading, show history">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Pressure"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PressureText"
                                       Text="—"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="31"
                                       FontWeight="Normal"/>
                            <TextBlock x:Name="PressureUnitText"
                                       Text="hPa"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="14"
                                       VerticalAlignment="Bottom"
                                       Margin="4,0,0,5"/>
                        </StackPanel>
                        <TextBlock x:Name="PressureRangeText"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </RadioButton>
            </Grid>

            <!-- Bottom strip: alert settings and sensor/system details -->
            <Grid x:Name="StatusStripGrid"
                  Grid.Row="2"
                  Grid.ColumnSpan="2"
                  Margin="-26,0,-26,-18">
                <Border Style="{StaticResource StatusStrip}"
                        Padding="24,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0">
                            <Ellipse x:Name="FooterStatusDot"
                                     Width="8"
                                     Height="8"
                                     Fill="{StaticResource Muted}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="FooterStatusText"
                                       Text="Searching"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <controls:SignalBars x:Name="DetailSignal"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,8,0"/>
                                <TextBlock x:Name="RssiText"
                                           Text="—"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="13"
                                           Visibility="Collapsed"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="3"
                                Style="{StaticResource SmallLinkButton}"
                                Click="DeviceChip_Click"
                                ToolTip="Open selected sensor details">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Battery"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <Border Width="24"
                                        Height="10"
                                        BorderBrush="{StaticResource TextSecondary}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Margin="8,0,0,0"
                                        Padding="1">
                                    <ProgressBar x:Name="FooterBatteryBar"
                                                 Style="{StaticResource ThinBar}"
                                                 Height="6"
                                                 VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="FooterBatteryText"
                                           Text="—"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontWeight="SemiBold"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Grid x:Name="HistoryView"
              Grid.Row="1"
              Margin="24,18,24,18"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="How the room breathed"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="HistoryHeaderSummaryText"
                               Text="No saved readings yet"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="HistoryLastSyncText"
                               Text="Not synced yet"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <Button x:Name="SyncHistoryButton"
                            Content="Sync history"
                            Style="{StaticResource HeaderActionButton}"
                            Click="SyncHistory_Click"
                            IsEnabled="False"
                            ToolTip="Download readings stored on the selected sensor"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="HistoryContentGrid"
                  Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="HistoryMainCard"
                        Style="{StaticResource CardStyle}"
                        Padding="20"
                        Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="300"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CO₂"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="HistoryChartStatsText"
                                           Text="No readings yet"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="13"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{StaticResource SurfaceSecondary}"
                                    CornerRadius="10"
                                    Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="History24HoursButton"
                                                 Content="24h"
                                                 Tag="24"
                                                 GroupName="HistoryRange"
                                                 Style="{StaticResource SegmentButton}"
                                                 IsChecked="True"
                                                 Checked="HistoryRangeButton_Checked"/>
                                    <RadioButton Content="7d"
                                                 Tag="168"
                                                 GroupName="HistoryRange"
                                                 Style="{StaticResource SegmentButton}"
                                                 Checked="HistoryRangeButton_Checked"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <controls:MetricChart x:Name="LongHistoryChart"
                                              Grid.Row="1"
                                              Margin="0,10,0,0"
                                              MinHeight="220"
                                              Focusable="True"
                                              KeyboardNavigation.IsTabStop="True"
                                              AutomationProperties.Name="CO₂ history over the selected range"
                                              AutomationProperties.HelpText="Use left and right arrow keys to inspect readings."/>
                        <StackPanel Grid.Row="2" Margin="0,12,0,8">
                            <TextBlock Text="Day at a glance"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="One stripe every 20 minutes · ● airing detected"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <UniformGrid x:Name="HistoryDayStrip"
                                     Grid.Row="3"
                                     Rows="1"
                                     Columns="72"
                                     Height="40"/>
                        <Grid Grid.Row="4" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HistoryStartTimeText"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"/>
                            <TextBlock x:Name="HistoryQuarterTimeText"
                                       Grid.Column="1"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"/>
                            <TextBlock x:Name="HistoryHalfTimeText"
                                       Grid.Column="2"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"/>
                            <TextBlock x:Name="HistoryThreeQuarterTimeText"
                                       Grid.Column="3"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"/>
                            <TextBlock Text="Now"
                                       Grid.Column="4"
                                       TextAlignment="Right"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="HistorySummaryCard"
                        Grid.Column="1"
                        Style="{StaticResource CardStyle}"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Time in each zone"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <Grid x:Name="HistoryZoneShareBar"
                              Height="12"
                              Margin="0,12,0,8"
                              ClipToBounds="True"/>
                        <TextBlock x:Name="HistoryZoneShareText"
                                   Text="No readings yet"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                        <Border Height="1"
                                Background="{StaticResource Border}"
                                Margin="0,16,0,14"/>
                        <TextBlock Text="Worth knowing"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="HistoryOvernightText"
                                   Text="Overnight: no readings yet."
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="HistoryAiringText"
                                   Text="No clear airing detected in the last 24 hours."
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <TextBlock x:Name="HistoryPeakText"
                                   Text="Highest: no readings yet."
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                        <Border Height="1"
                                Background="{StaticResource Border}"
                                Margin="0,16,0,14"/>
                        <TextBlock Text="Export"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Raw measurements for the selected range."
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,10"/>
                        <Button x:Name="HistoryExportButton"
                                Content="Export CSV"
                                Tag="visible"
                                Style="{StaticResource GhostButton}"
                                Click="ExportCsv_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
        </Grid>
        </ScrollViewer>
        <Border x:Name="SyncToast"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="12"
                Style="{StaticResource ToastCard}"
                Padding="12,8"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <TextBlock x:Name="SyncToastText"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="13"/>
        </Border>
    </Grid>
    </Border>
</Window>
