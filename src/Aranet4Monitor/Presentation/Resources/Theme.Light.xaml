<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- Air Pulse light palette. Colour tokens only; keep the key set identical to Theme.Dark.xaml. -->
        <Color x:Key="AppBackgroundColor">#F7F8F6</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="SurfaceSecondaryColor">#EEF2F3</Color>
        <Color x:Key="MetricCardColor">#FFFFFF</Color>
        <!-- Raised card surface for the hero. Do not use SurfaceSecondary here: that token is for sunken wells. -->
        <Color x:Key="HeroSurfaceColor">#FFFFFF</Color>
        <Color x:Key="DangerBackgroundColor">#0DC9564E</Color>
        <Color x:Key="WarningBackgroundColor">#0DD7952F</Color>
        <Color x:Key="PositiveBackgroundColor">#0D18A978</Color>
        <Color x:Key="SurfaceHoverColor">#F0F3F3</Color>
        <Color x:Key="SurfaceSelectedColor">#E8F7F1</Color>
        <Color x:Key="BorderColor">#E4E9EB</Color>
        <Color x:Key="TextPrimaryColor">#17212B</Color>
        <Color x:Key="TextSecondaryColor">#66727C</Color>
        <Color x:Key="AccentColor">#3779BD</Color>
        <Color x:Key="PositiveColor">#18A978</Color>
        <Color x:Key="OnPositiveColor">#FFFFFF</Color>
        <Color x:Key="WarningColor">#D7952F</Color>
        <Color x:Key="DangerColor">#C9564E</Color>
        <Color x:Key="InfoColor">#3779BD</Color>
        <Color x:Key="TemperatureAccentColor">#D67A25</Color>
        <Color x:Key="HumidityAccentColor">#3779BD</Color>
        <Color x:Key="PressureAccentColor">#7655BD</Color>
        <Color x:Key="Co2GoodColor">#18A978</Color>
        <Color x:Key="Co2FairColor">#D7952F</Color>
        <Color x:Key="Co2PoorColor">#C9564E</Color>
        <Color x:Key="Co2GoodStrokeColor">#18A978</Color>
        <Color x:Key="Co2FairStrokeColor">#D7952F</Color>
        <Color x:Key="Co2PoorStrokeColor">#C9564E</Color>
        <Color x:Key="Co2GoodZoneColor">#18A978</Color>
        <Color x:Key="Co2FairZoneColor">#D7952F</Color>
        <Color x:Key="Co2PoorZoneColor">#C9564E</Color>
        <Color x:Key="DisabledColor">#9AA8B0</Color>
    
        <!-- Darker variants of the zone colours, readable as small text on white. -->
        <Color x:Key="Co2GoodTextColor">#16865F</Color>
        <Color x:Key="Co2FairTextColor">#A8700F</Color>
        <Color x:Key="Co2PoorTextColor">#B13F38</Color>
        <SolidColorBrush x:Key="Co2GoodText" Color="{StaticResource Co2GoodTextColor}"/>
        <SolidColorBrush x:Key="Co2FairText" Color="{StaticResource Co2FairTextColor}"/>
        <SolidColorBrush x:Key="Co2PoorText" Color="{StaticResource Co2PoorTextColor}"/>

        <SolidColorBrush x:Key="TextPrimary"
                         Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondary"
                         Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="Surface"
                         Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="SurfaceSecondary"
                         Color="{StaticResource SurfaceSecondaryColor}"/>
        <SolidColorBrush x:Key="MetricCard"
                         Color="{StaticResource MetricCardColor}"/>
        <SolidColorBrush x:Key="HeroSurface"
                         Color="{StaticResource HeroSurfaceColor}"/>
        <SolidColorBrush x:Key="DangerBackground"
                         Color="{StaticResource DangerBackgroundColor}"/>
        <SolidColorBrush x:Key="WarningBackground"
                         Color="{StaticResource WarningBackgroundColor}"/>
        <SolidColorBrush x:Key="PositiveBackground"
                         Color="{StaticResource PositiveBackgroundColor}"/>
        <SolidColorBrush x:Key="SurfaceHover"
                         Color="{StaticResource SurfaceHoverColor}"/>
        <SolidColorBrush x:Key="SurfaceSelected"
                         Color="{StaticResource SurfaceSelectedColor}"/>
        <SolidColorBrush x:Key="AppBackground"
                         Color="{StaticResource AppBackgroundColor}"/>
        <SolidColorBrush x:Key="Border"
                         Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="Accent"
                         Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="Positive"
                         Color="{StaticResource PositiveColor}"/>
        <SolidColorBrush x:Key="OnPositive"
                         Color="{StaticResource OnPositiveColor}"/>
        <SolidColorBrush x:Key="Info"
                         Color="{StaticResource InfoColor}"/>
        <SolidColorBrush x:Key="TemperatureAccent"
                         Color="{StaticResource TemperatureAccentColor}"/>
        <SolidColorBrush x:Key="HumidityAccent"
                         Color="{StaticResource HumidityAccentColor}"/>
        <SolidColorBrush x:Key="PressureAccent"
                         Color="{StaticResource PressureAccentColor}"/>
        <SolidColorBrush x:Key="Warning"
                         Color="{StaticResource WarningColor}"/>
        <SolidColorBrush x:Key="Danger"
                         Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="Co2Good"
                         Color="{StaticResource Co2GoodColor}"/>
        <SolidColorBrush x:Key="Co2Fair"
                         Color="{StaticResource Co2FairColor}"/>
        <SolidColorBrush x:Key="Co2Poor"
                         Color="{StaticResource Co2PoorColor}"/>
        <SolidColorBrush x:Key="Co2GoodStroke"
                         Color="{StaticResource Co2GoodStrokeColor}"/>
        <SolidColorBrush x:Key="Co2FairStroke"
                         Color="{StaticResource Co2FairStrokeColor}"/>
        <SolidColorBrush x:Key="Co2PoorStroke"
                         Color="{StaticResource Co2PoorStrokeColor}"/>
        <SolidColorBrush x:Key="Co2GoodZone"
                         Color="{StaticResource Co2GoodZoneColor}"/>
        <SolidColorBrush x:Key="Co2FairZone"
                         Color="{StaticResource Co2FairZoneColor}"/>
        <SolidColorBrush x:Key="Co2PoorZone"
                         Color="{StaticResource Co2PoorZoneColor}"/>
        <SolidColorBrush x:Key="Disabled"
                         Color="{StaticResource DisabledColor}"/>

        <!-- Compatibility aliases used by existing view markup; migrate them with the consuming views. -->
        <SolidColorBrush x:Key="Ink"
                         Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="Muted"
                         Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="Card"
                         Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="Line"
                         Color="{StaticResource BorderColor}"/>
</ResourceDictionary>
