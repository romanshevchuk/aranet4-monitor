<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <Style x:Key="PopoverCard"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="CornerRadius"
                        Value="{StaticResource CardRadius}"/>
                <Setter Property="Padding"
                        Value="16"/>
        </Style>

        <Style x:Key="StatusBanner"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{DynamicResource WarningBackground}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Warning}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="CornerRadius"
                        Value="8"/>
                <Setter Property="Padding"
                        Value="12,8"/>
        </Style>

        <Style x:Key="ToastCard"
               TargetType="Border">
                <Setter Property="Width"
                        Value="400"/>
                <Setter Property="Margin"
                        Value="{StaticResource CardRadius}"/>
                <Setter Property="CornerRadius"
                        Value="8"/>
                <Setter Property="Background"
                        Value="{DynamicResource Surface}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
                <Setter Property="Effect">
                        <Setter.Value>
                                <DropShadowEffect BlurRadius="16"
                                                  ShadowDepth="3"
                                                  Opacity="0.3"
                                                  Color="Black"/>
                        </Setter.Value>
                </Setter>
        </Style>

        <Style x:Key="CardStyle"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{DynamicResource Surface}"/>
                <Setter Property="CornerRadius"
                        Value="{StaticResource CardRadius}"/>
                <Setter Property="Padding"
                        Value="22"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness"
                        Value="1"/>
        </Style>

        <Style x:Key="StatusStrip"
               TargetType="Border">
                <Setter Property="Background"
                        Value="{DynamicResource AppBackground}"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness"
                        Value="0,1,0,0"/>
                <Setter Property="CornerRadius"
                        Value="0"/>
                <Setter Property="Padding"
                        Value="22,8"/>
        </Style>
</ResourceDictionary>
